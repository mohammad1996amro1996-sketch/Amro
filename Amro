<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الغرف الصوتية المتاحة"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <ListView
        android:id="@+id/listViewRooms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#222222"
        android:dividerHeight="8dp"/>

</LinearLayout>
package com.amro.voicechat

import android.content.Intent
import android.os.Bundle
import android:widget.ArrayAdapter
import android:widget.ListView
import androidx.appcompat.app.AppCompatActivity

class HomeActivity : AppCompatActivity() {
    private val roomsList = arrayOf(
        "🇵🇸 فلسطين تجمعنا",
        "أصدقاء",
        "أغاني وطرب",
        "دردشة وتعارف",
        "🛒 غرفة مبيعات الغرف"
    )

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_home)

        val listView = findViewById<ListView>(R.id.listViewRooms)
        val adapter = ArrayAdapter(this, android.R.layout.simple_list_item_1, roomsList)
        listView.adapter = adapter

        listView.setOnItemClickListener { _, _, position, _ ->
            val selectedRoom = roomsList[position]
            val intent = Intent(this, RoomActivity::class.java)
            intent.putExtra("ROOM_NAME", selectedRoom)
            startActivity(intent)
        }
    }
}
